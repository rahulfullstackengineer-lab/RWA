# ============================================================
# RWA SaaS Management Portal — Production Environment Variables
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------
# For PostgreSQL (Recommended for production):
# DATABASE_URL="postgresql://user:password@localhost:5432/rwa_db?schema=public&sslmode=prefer"
#
# For SQLite (Single-server / VPS persistence):
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------
# 2. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Public URL of your deployed application (No trailing slash)
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="RWA Manager"

# Real-time WebSocket connection URL
# Leave empty string "" to use same-origin relative connection (recommended for reverse proxies/custom domains)
NEXT_PUBLIC_SOCKET_URL=""

# Allowed CORS origins for WebSocket / API (comma-separated or single domain)
CORS_ORIGIN="https://your-domain.com"

# ------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------
# Generate strong 32+ character secrets (e.g., using `openssl rand -hex 32`)
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_32_CHAR_SECRET_FOR_PRODUCTION"
JWT_SECRET="REPLACE_WITH_STRONG_32_CHAR_JWT_SECRET_FOR_PRODUCTION"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------
# Get live keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_live_REPLACE_WITH_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_LIVE_KEY_SECRET"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_REPLACE_WITH_LIVE_KEY_ID"

# ------------------------------------------------------------
# 5. SMS & OTP NOTIFICATIONS (Twilio / SMS Gateway)
# ------------------------------------------------------------
OTP_EXPIRY_MINUTES="10"
# Uncomment and configure for production SMS delivery:
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+1xxxxxxxxxx"
